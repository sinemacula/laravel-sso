{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src"
        ],
        // The contract kits are assertions a binder's tests run; their own
        // tests prove each against a binding that breaks it
        excludes: [
            "Testing/Seams"
        ]
    },
    logs: {
        summary: "build/infection-summary.log",
        text: "build/infection.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    initialTestsPhpOptions: "-d memory_limit=1G",
    timeout: 30,
    mutators: {
        "@default": true
    }
}
