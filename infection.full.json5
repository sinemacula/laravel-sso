{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src"
        ],
        // The contract kits are assertions a binder's tests run; their own
        // tests prove each against a binding that breaks it
        excludes: [
            "Testing/Seams"
        ]
    },
    logs: {
        summary: "build/infection-full-summary.log",
        text: "build/infection-full.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    // The initial run is the whole suite with coverage in one process
    initialTestsPhpOptions: "-d memory_limit=-1",
    timeout: 30,
    mutators: {
        "@default": true,
        // hrtime(true) is already an int on 64-bit, so the cast cannot be told apart
        CastInt: {
            ignore: ["SineMacula\\Laravel\\Sso\\Fetching\\GuzzleFetcher::__construct"]
        },
        // ICU rejects every label the pattern would, so no input reaches the loop's refusal
        Foreach_: {
            ignore: ["SineMacula\\Laravel\\Sso\\Domains\\DomainName::areLabels"]
        }
    }
}
