<?xml version="1.0"?>
<ruleset name="Project">

    <!-- DisallowMixedTypeHint excluded: the package maps claims and attributes
         asserted by arbitrary identity providers, and config values, metadata
         and identity references are user-shaped by design. PHPStan still guards
         unsafe mixed access. -->
    <rule ref="SineMaculaLaravelPackage">
        <exclude name="SlevomatCodingStandard.TypeHints.DisallowMixedTypeHint"/>
    </rule>

    <!-- SsoModel joins the parents whose subclasses may declare Eloquent's
         mutable public properties ($timestamps, $incrementing): every package
         model extends it rather than Model directly. -->
    <rule ref="SineMacula.Classes.RequireReadonlyPublicProperty">
        <properties>
            <property name="ignoredParentClasses" type="array" extend="true">
                <element value="SsoModel"/>
            </property>
        </properties>
    </rule>

    <file>src</file>
    <file>benchmarks</file>
    <file>database</file>
    <file>tests</file>

</ruleset>
