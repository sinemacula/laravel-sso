root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
indent_size = unset

[*.{yml,yaml}]
indent_size = 2

# The SAML fixtures are signed byte for byte, one of them in UTF-16
[tests/Fixtures/Saml/{responses/*.xml,xxe-secret.txt}]
charset = unset
insert_final_newline = unset
